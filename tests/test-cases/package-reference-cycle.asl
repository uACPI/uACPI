// Name: Package reference cycles are rejected
// Expect: int => 0

DefinitionBlock ("", "DSDT", 2, "uTEST", "TESTTABL", 0xF0F0F0F0)
{
    Name (PKG0, Package (2) { 0, 0 })
    Name (PKG1, Package (2) { 0, 0 })
    Name (PKG2, Package (1) { Package (1) { 0 } })
    Name (PKG3, Package (2) { 0, 0 })

    /*
     * A cyclic store aborts the running method, and an aborted method
     * invoked from table-level code doesn't fail the table load, so every
     * case below is hand-encoded as top-level code of its own SSDT. That
     * way the error turns into a failed Load() instead. This also allows
     * for things iasl refuses to compile, like CopyObject with an Index
     * target and locals outside of a method.
     */

    /*
     * Direct self reference
     *
     * DefinitionBlock ("", "SSDT", 2, "uTEST", "CYCTBL_0", 1)
     * {
     *     PKG0[0] = RefOf (PKG0)
     * }
     */
    Name (DIRC, Buffer () {
        0x53, 0x53, 0x44, 0x54, 0x31, 0x00, 0x00, 0x00,
        0x02, 0xB2, 0x75, 0x54, 0x45, 0x53, 0x54, 0x20,
        0x43, 0x59, 0x43, 0x54, 0x42, 0x4C, 0x5F, 0x30,
        0x01, 0x00, 0x00, 0x00, 0x55, 0x41, 0x43, 0x50,
        0x01, 0x00, 0x00, 0x00, 0x70, 0x71, 0x50, 0x4B,
        0x47, 0x30, 0x88, 0x50, 0x4B, 0x47, 0x30, 0x00,
        0x00
    })

    /*
     * PKG0 -> PKG1 -> PKG0
     *
     * DefinitionBlock ("", "SSDT", 2, "uTEST", "CYCTBL_1", 1)
     * {
     *     PKG1[0] = RefOf (PKG0)
     *     PKG0[1] = RefOf (PKG1)
     * }
     */
    Name (INDC, Buffer () {
        0x53, 0x53, 0x44, 0x54, 0x3E, 0x00, 0x00, 0x00,
        0x02, 0x14, 0x75, 0x54, 0x45, 0x53, 0x54, 0x20,
        0x43, 0x59, 0x43, 0x54, 0x42, 0x4C, 0x5F, 0x31,
        0x01, 0x00, 0x00, 0x00, 0x55, 0x41, 0x43, 0x50,
        0x01, 0x00, 0x00, 0x00, 0x70, 0x71, 0x50, 0x4B,
        0x47, 0x30, 0x88, 0x50, 0x4B, 0x47, 0x31, 0x00,
        0x00, 0x70, 0x71, 0x50, 0x4B, 0x47, 0x31, 0x88,
        0x50, 0x4B, 0x47, 0x30, 0x01, 0x00
    })

    /*
     * A temporary package referencing itself through its local
     *
     * DefinitionBlock ("", "SSDT", 2, "uTEST", "CYCTBL_2", 1)
     * {
     *     Local0 = Package (1) { 0 }
     *     Local0[0] = RefOf (Local0)
     * }
     */
    Name (LOCC, Buffer () {
        0x53, 0x53, 0x44, 0x54, 0x31, 0x00, 0x00, 0x00,
        0x02, 0x2E, 0x75, 0x54, 0x45, 0x53, 0x54, 0x20,
        0x43, 0x59, 0x43, 0x54, 0x42, 0x4C, 0x5F, 0x32,
        0x01, 0x00, 0x00, 0x00, 0x55, 0x41, 0x43, 0x50,
        0x01, 0x00, 0x00, 0x00, 0x70, 0x12, 0x03, 0x01,
        0x00, 0x60, 0x70, 0x71, 0x60, 0x88, 0x60, 0x00,
        0x00
    })

    /*
     * A nested package referencing its parent
     *
     * DefinitionBlock ("", "SSDT", 2, "uTEST", "CYCTBL_3", 1)
     * {
     *     Local0 = PKG2[0]
     *     DerefOf (Local0)[0] = RefOf (PKG2)
     * }
     */
    Name (NEST, Buffer () {
        0x53, 0x53, 0x44, 0x54, 0x38, 0x00, 0x00, 0x00,
        0x02, 0x69, 0x75, 0x54, 0x45, 0x53, 0x54, 0x20,
        0x43, 0x59, 0x43, 0x54, 0x42, 0x4C, 0x5F, 0x33,
        0x01, 0x00, 0x00, 0x00, 0x55, 0x41, 0x43, 0x50,
        0x01, 0x00, 0x00, 0x00, 0x70, 0x88, 0x50, 0x4B,
        0x47, 0x32, 0x00, 0x00, 0x60, 0x70, 0x71, 0x50,
        0x4B, 0x47, 0x32, 0x88, 0x83, 0x60, 0x00, 0x00
    })

    /*
     * Same as DIRC but via CopyObject
     *
     * DefinitionBlock ("", "SSDT", 2, "uTEST", "CYCTBL_4", 1)
     * {
     *     CopyObject (RefOf (PKG0), Index (PKG0, 0))
     * }
     */
    Name (COPY, Buffer () {
        0x53, 0x53, 0x44, 0x54, 0x31, 0x00, 0x00, 0x00,
        0x02, 0x81, 0x75, 0x54, 0x45, 0x53, 0x54, 0x20,
        0x43, 0x59, 0x43, 0x54, 0x42, 0x4C, 0x5F, 0x34,
        0x01, 0x00, 0x00, 0x00, 0x55, 0x41, 0x43, 0x50,
        0x01, 0x00, 0x00, 0x00, 0x9D, 0x71, 0x50, 0x4B,
        0x47, 0x30, 0x88, 0x50, 0x4B, 0x47, 0x30, 0x00,
        0x00
    })

    /*
     * References to other packages are fine
     *
     * DefinitionBlock ("", "SSDT", 2, "uTEST", "CYCTBL_5", 1)
     * {
     *     PKG3[0] = RefOf (PKG0)
     *     PKG3[1] = RefOf (PKG2)
     * }
     */
    Name (OKAY, Buffer () {
        0x53, 0x53, 0x44, 0x54, 0x3E, 0x00, 0x00, 0x00,
        0x02, 0x0A, 0x75, 0x54, 0x45, 0x53, 0x54, 0x20,
        0x43, 0x59, 0x43, 0x54, 0x42, 0x4C, 0x5F, 0x35,
        0x01, 0x00, 0x00, 0x00, 0x55, 0x41, 0x43, 0x50,
        0x01, 0x00, 0x00, 0x00, 0x70, 0x71, 0x50, 0x4B,
        0x47, 0x30, 0x88, 0x50, 0x4B, 0x47, 0x33, 0x00,
        0x00, 0x70, 0x71, 0x50, 0x4B, 0x47, 0x32, 0x88,
        0x50, 0x4B, 0x47, 0x33, 0x01, 0x00
    })

    /*
     * A package containing a reference stored by value
     *
     * DefinitionBlock ("", "SSDT", 2, "uTEST", "CYCTBL_6", 1)
     * {
     *     PKG1[1] = RefOf (PKG0)
     *     PKG0[1] = PKG1
     * }
     */
    Name (PKGV, Buffer () {
        0x53, 0x53, 0x44, 0x54, 0x3D, 0x00, 0x00, 0x00,
        0x02, 0x80, 0x75, 0x54, 0x45, 0x53, 0x54, 0x20,
        0x43, 0x59, 0x43, 0x54, 0x42, 0x4C, 0x5F, 0x36,
        0x01, 0x00, 0x00, 0x00, 0x55, 0x41, 0x43, 0x50,
        0x01, 0x00, 0x00, 0x00, 0x70, 0x71, 0x50, 0x4B,
        0x47, 0x30, 0x88, 0x50, 0x4B, 0x47, 0x31, 0x01,
        0x00, 0x70, 0x50, 0x4B, 0x47, 0x31, 0x88, 0x50,
        0x4B, 0x47, 0x30, 0x01, 0x00
    })

    /*
     * A local referencing itself
     *
     * DefinitionBlock ("", "SSDT", 2, "uTEST", "CYCTBL_7", 1)
     * {
     *     Local0 = 1
     *     Local0 = RefOf (Local0)
     * }
     */
    Name (LOCR, Buffer () {
        0x53, 0x53, 0x44, 0x54, 0x2B, 0x00, 0x00, 0x00,
        0x02, 0xCC, 0x75, 0x54, 0x45, 0x53, 0x54, 0x20,
        0x43, 0x59, 0x43, 0x54, 0x42, 0x4C, 0x5F, 0x37,
        0x01, 0x00, 0x00, 0x00, 0x55, 0x41, 0x43, 0x50,
        0x01, 0x00, 0x00, 0x00, 0x70, 0x01, 0x60, 0x70,
        0x71, 0x60, 0x60
    })

    Method (MAIN, 0, NotSerialized)
    {
        Local0 = 0

        // Every cyclic store must fail the load
        Local0 += Load (DIRC)
        Local0 += Load (INDC)
        Local0 += Load (LOCC)
        Local0 += Load (NEST)
        Local0 += Load (COPY)
        Local0 += Load (PKGV)
        Local0 += Load (LOCR)

        // But a non-cyclic one must succeed
        Local0 += !Load (OKAY)

        Return (Local0)
    }
}
