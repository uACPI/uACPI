// Name: Looking for a reference cycle only visits an object once
// Expect: int => 0

DefinitionBlock ("", "DSDT", 2, "uTEST", "TESTTABL", 0xF0F0F0F0)
{
    Name (PK00, Package (2) { 0, 0 })
    Name (PK01, Package (2) { 0, 0 })
    Name (PK02, Package (2) { 0, 0 })
    Name (PK03, Package (2) { 0, 0 })
    Name (PK04, Package (2) { 0, 0 })
    Name (PK05, Package (2) { 0, 0 })
    Name (PK06, Package (2) { 0, 0 })
    Name (PK07, Package (2) { 0, 0 })
    Name (PK08, Package (2) { 0, 0 })
    Name (PK09, Package (2) { 0, 0 })
    Name (PK10, Package (2) { 0, 0 })
    Name (PK11, Package (2) { 0, 0 })
    Name (PK12, Package (2) { 0, 0 })
    Name (PK13, Package (2) { 0, 0 })
    Name (PK14, Package (2) { 0, 0 })
    Name (PK15, Package (2) { 0, 0 })
    Name (PK16, Package (2) { 0, 0 })
    Name (PK17, Package (2) { 0, 0 })
    Name (PK18, Package (2) { 0, 0 })
    Name (PK19, Package (2) { 0, 0 })
    Name (PK20, Package (2) { 0, 0 })
    Name (PK21, Package (2) { 0, 0 })
    Name (PK22, Package (2) { 0, 0 })
    Name (PK23, Package (2) { 0, 0 })
    Name (PK24, Package (2) { 0, 0 })
    Name (PK25, Package (2) { 0, 0 })
    Name (PK26, Package (2) { 0, 0 })
    Name (PK27, Package (2) { 0, 0 })
    Name (PK28, Package (2) { 0, 0 })
    Name (PK29, Package (2) { 0, 0 })
    Name (PK30, Package (2) { 0, 0 })
    Name (PK31, Package (2) { 0, 0 })
    Name (PK32, Package (2) { 0, 0 })

    Method (MAIN) {
        /*
         * Every package refers to the one before it twice, so the number of
         * ways to get from the last one to the first one doubles with every
         * package that we link. There's no cycle in any of this, but making
         * sure of that by following every single one of them takes forever.
         */
        PK01[0] = RefOf (PK00)
        PK01[1] = RefOf (PK00)
        PK02[0] = RefOf (PK01)
        PK02[1] = RefOf (PK01)
        PK03[0] = RefOf (PK02)
        PK03[1] = RefOf (PK02)
        PK04[0] = RefOf (PK03)
        PK04[1] = RefOf (PK03)
        PK05[0] = RefOf (PK04)
        PK05[1] = RefOf (PK04)
        PK06[0] = RefOf (PK05)
        PK06[1] = RefOf (PK05)
        PK07[0] = RefOf (PK06)
        PK07[1] = RefOf (PK06)
        PK08[0] = RefOf (PK07)
        PK08[1] = RefOf (PK07)
        PK09[0] = RefOf (PK08)
        PK09[1] = RefOf (PK08)
        PK10[0] = RefOf (PK09)
        PK10[1] = RefOf (PK09)
        PK11[0] = RefOf (PK10)
        PK11[1] = RefOf (PK10)
        PK12[0] = RefOf (PK11)
        PK12[1] = RefOf (PK11)
        PK13[0] = RefOf (PK12)
        PK13[1] = RefOf (PK12)
        PK14[0] = RefOf (PK13)
        PK14[1] = RefOf (PK13)
        PK15[0] = RefOf (PK14)
        PK15[1] = RefOf (PK14)
        PK16[0] = RefOf (PK15)
        PK16[1] = RefOf (PK15)
        PK17[0] = RefOf (PK16)
        PK17[1] = RefOf (PK16)
        PK18[0] = RefOf (PK17)
        PK18[1] = RefOf (PK17)
        PK19[0] = RefOf (PK18)
        PK19[1] = RefOf (PK18)
        PK20[0] = RefOf (PK19)
        PK20[1] = RefOf (PK19)
        PK21[0] = RefOf (PK20)
        PK21[1] = RefOf (PK20)
        PK22[0] = RefOf (PK21)
        PK22[1] = RefOf (PK21)
        PK23[0] = RefOf (PK22)
        PK23[1] = RefOf (PK22)
        PK24[0] = RefOf (PK23)
        PK24[1] = RefOf (PK23)
        PK25[0] = RefOf (PK24)
        PK25[1] = RefOf (PK24)
        PK26[0] = RefOf (PK25)
        PK26[1] = RefOf (PK25)
        PK27[0] = RefOf (PK26)
        PK27[1] = RefOf (PK26)
        PK28[0] = RefOf (PK27)
        PK28[1] = RefOf (PK27)
        PK29[0] = RefOf (PK28)
        PK29[1] = RefOf (PK28)
        PK30[0] = RefOf (PK29)
        PK30[1] = RefOf (PK29)
        PK31[0] = RefOf (PK30)
        PK31[1] = RefOf (PK30)
        PK32[0] = RefOf (PK31)
        PK32[1] = RefOf (PK31)

        // Make sure that the references are actually there
        Local0 = DerefOf (PK32[1])
        If (ObjectType (Local0) != 4) {
            Printf("Unexpected object at the end of a reference: %o", Local0)
            Return (1)
        }

        Return (0)
    }
}
